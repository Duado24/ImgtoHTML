{
  "name": "imgtohtml-web",
  "version": "2.0.0",
  "private": true,
  "description": "ImgtoHTML in the browser: screenshot to Canvas HTML, all processing local.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "gifuct-js": "^2.1.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
