{
  "name": "imgtohtml-web",
  "version": "2.0.0",
  "private": true,
  "description": "ImgtoHTML in the browser: screenshot to Canvas HTML, all processing local.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@tesseract.js-data/eng": "^1.0.0",
    "bmp-ts": "^1.0.9",
    "fastify": "^5.12.7",
    "gifuct-js": "^2.1.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
